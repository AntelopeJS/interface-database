{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "paths": {
      "@antelopejs/interface-database": ["../src/index.ts"],
      "@antelopejs/interface-database/*": ["../src/*"]
    }
  },
  "include": ["../src/**/*.ts", "./**/*.ts"]
}
